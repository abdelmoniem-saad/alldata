DATABASE_URL=sqlite+aiosqlite:///./alldata.db
# For a durable deployment (Hugging Face Space + Neon/Supabase), point this at
# an external Postgres instead — the driver is asyncpg:
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# C6a: re-parse every seed content.md on each boot (idempotent). Off by
# default; enable on deployments that want seed edits to go live on restart
# without a hand-run `python -m seed.import_seed --refresh-content`.
CONTENT_REFRESH_ON_BOOT=false


